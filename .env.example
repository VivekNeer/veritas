# Copy this file to .env and fill in your own values.
# .env is gitignored — never commit real project IDs, bucket names are not
# secret but keep this file as the template so nothing is committed by habit.

# ---------------------------------------------------------------------------
# INGESTION SOURCE
# ---------------------------------------------------------------------------
# true  -> read JSON from SAMPLE_DATA_DIR (no GCP needed at all)
# false -> read JSON from the real GCS bucket named in GCS_BUCKET
LOCAL_MODE=true
SAMPLE_DATA_DIR=sample-data

# ---------------------------------------------------------------------------
# STORAGE BACKEND
# ---------------------------------------------------------------------------
# sqlite   -> local_warehouse.db, no GCP needed, good for fast iteration
# bigquery -> the real target described in the architecture doc
STORAGE_BACKEND=sqlite
SQLITE_PATH=local_warehouse.db

# ---------------------------------------------------------------------------
# GCP (only read when LOCAL_MODE=false and/or STORAGE_BACKEND=bigquery)
# ---------------------------------------------------------------------------
GCP_PROJECT_ID=your-gcp-project-id
GCS_BUCKET=veritas-claims-raw-<your-suffix>
BQ_DATASET=veritas_claims
BQ_LOCATION=US

LOG_LEVEL=INFO
